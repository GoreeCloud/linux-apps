{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/care/continuity.status.schema.json",
  "title": "GoreeCloud Care Continuity Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "producer",
    "scope",
    "dimension",
    "state",
    "stage",
    "observed_at",
    "required_evidence",
    "verification_method",
    "evidence_reference",
    "reason",
    "limitations"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^goreecloud-care-package-rollback-[0-9]{8}T[0-9]{6}Z$"
    },
    "producer": {"const": "GoreeCloud Care"},
    "scope": {"const": "goreecloud-care Debian package lifecycle"},
    "dimension": {"const": "restore_capability"},
    "state": {"enum": ["attention", "ready"]},
    "stage": {
      "enum": [
        "provenance-unavailable",
        "target-acceptance-required",
        "target-accepted-governance-pending",
        "everkeep-promoted"
      ]
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "required_evidence": {"const": true},
    "verification_method": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence_reference": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^file:///", "maxLength": 1000}
      ]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "freshness": {"const": "exact-build-bound"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "ready"}}, "required": ["state"]},
      "then": {
        "properties": {
          "stage": {"const": "everkeep-promoted"},
          "limitations": {"maxItems": 0},
          "evidence_reference": {"type": "string", "pattern": "^file:///"},
          "freshness": {"const": "exact-build-bound"}
        },
        "required": ["freshness"]
      }
    },
    {
      "if": {"properties": {"state": {"const": "attention"}}, "required": ["state"]},
      "then": {
        "not": {"required": ["freshness"]}
      }
    }
  ]
}
