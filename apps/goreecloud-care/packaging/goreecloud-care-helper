#!/bin/sh
set -eu
# This entry point may execute as root through PolicyKit. Isolated mode is
# mandatory so a user-controlled working directory, PYTHONPATH, or user site
# cannot shadow the installed goreecloud_care package. -B prevents root-owned
# runtime bytecode from accumulating in the private package directory.
exec /usr/bin/python3 -I -B -m goreecloud_care.helper "$@"
