#!/bin/sh
set -e

# Remove only runtime-generated bytecode inside Care's fixed private install
# directory. No user-owned maintenance data or user files are touched.
rm -rf -- /usr/lib/goreecloud-care/goreecloud_care/__pycache__
rmdir /usr/lib/goreecloud-care/goreecloud_care 2>/dev/null || true
rmdir /usr/lib/goreecloud-care 2>/dev/null || true

exit 0
